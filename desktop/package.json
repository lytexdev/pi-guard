{
  "name": "pi-guard-desktop",
  "productName": "PiGuard",
  "version": "1.3.0",
  "description": "The pi-guard dashboard as an app for Windows, Linux and macOS",
  "author": "lytex",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "de.lytex.piguard",
    "files": [
      "main.js",
      "preload.js",
      "trust.js",
      "updates.js",
      "pages/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "PiGuard-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "tar.gz",
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Security",
      "maintainer": "lytex",
      "executableName": "pi-guard-desktop"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1"
      ]
    },
    "rpm": {
      "depends": [
        "libgtk-3.so.0()(64bit)",
        "libnotify.so.4()(64bit)",
        "libnss3.so()(64bit)",
        "libXss.so.1()(64bit)",
        "libXtst.so.6()(64bit)",
        "libatspi.so.0()(64bit)",
        "libuuid.so.1()(64bit)",
        "libasound.so.2()(64bit)",
        "libgbm.so.1()(64bit)",
        "xdg-utils"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libnotify",
        "libxss",
        "libxtst",
        "xdg-utils",
        "mesa"
      ]
    }
  },
  "homepage": "https://github.com/lytexdev/pi-guard",
  "desktopName": "pi-guard-desktop.desktop",
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    }
  }
}
