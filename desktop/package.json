{
  "name": "pi-guard-desktop",
  "productName": "PiGuard",
  "version": "1.2.0",
  "description": "The pi-guard dashboard as an app for Windows, Linux and macOS",
  "author": "lytex",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "de.lytex.piguard",
    "files": [
      "main.js",
      "preload.js",
      "trust.js",
      "updates.js",
      "pages/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "PiGuard-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "tar.gz",
        "AppImage",
        "deb"
      ],
      "category": "Security",
      "maintainer": "lytex"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null
    }
  },
  "homepage": "https://github.com/lytexdev/pi-guard",
  "desktopName": "pi-guard-desktop.desktop",
  "overrides": {
    "@electron/universal": {
      "minimatch": "^11.0.1"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    }
  }
}
