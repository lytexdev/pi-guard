<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The dashboard's colours, light or dark as the system is, so the native screens and the
         dashboard read as one app. -->
    <!-- Quick actions from the app icon: no window of their own, only a dialog or a toast. -->
    <style name="Theme.PiGuard.Invisible" parent="Theme.PiGuard">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <style name="Theme.PiGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_ink</item>
        <item name="colorSecondaryContainer">@color/surface2</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface2</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/muted</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="materialButtonStyle">@style/Button</item>
    </style>
</resources>
