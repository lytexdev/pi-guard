<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Heading"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:layout_marginStart">10dp</item><item name="android:textStyle">bold</item><item name="android:textSize">16sp</item><item name="android:textColor">@color/text</item></style>
    <style name="Hint"><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">@color/muted</item><item name="android:textSize">13sp</item></style>
    <style name="Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item>
    </style>
    <style name="Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item>
    </style>
    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item><item name="strokeColor">@color/danger</item><item name="android:textColor">@color/danger</item><item name="iconTint">@color/danger</item>
    </style>
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">14dp</item><item name="cardBackgroundColor">@color/surface</item><item name="cardElevation">0dp</item><item name="strokeColor">@color/line</item><item name="strokeWidth">1dp</item><item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item><item name="boxCornerRadiusTopEnd">10dp</item><item name="boxCornerRadiusBottomStart">10dp</item><item name="boxCornerRadiusBottomEnd">10dp</item><item name="boxStrokeColor">@color/accent</item><item name="startIconTint">@color/muted</item>
    </style>
</resources>
