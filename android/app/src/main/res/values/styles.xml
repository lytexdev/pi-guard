<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Heading"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:layout_marginStart">10dp</item><item name="android:textStyle">bold</item><item name="android:textSize">16sp</item><item name="android:textColor">?attr/pgText</item></style>
    <style name="Hint"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:textColor">?attr/pgMuted</item><item name="android:textSize">13sp</item><item name="android:lineSpacingMultiplier">1.15</item></style>
    <style name="Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">none</item>
    </style>
    <style name="Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item>
    </style>
    <style name="Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item>
    </style>
    <style name="Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item><item name="android:minHeight">52dp</item><item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="iconGravity">textStart</item><item name="iconPadding">8dp</item><item name="strokeColor">?attr/pgDanger</item><item name="android:textColor">?attr/pgDanger</item><item name="iconTint">?attr/pgDanger</item>
    </style>
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">14dp</item><item name="cardBackgroundColor">?attr/pgSurface</item><item name="cardElevation">0dp</item><item name="strokeColor">?attr/pgLine</item><item name="strokeWidth">1dp</item><item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item><item name="boxCornerRadiusTopEnd">10dp</item><item name="boxCornerRadiusBottomStart">10dp</item><item name="boxCornerRadiusBottomEnd">10dp</item><item name="boxStrokeColor">?attr/pgAccent</item><item name="startIconTint">?attr/pgMuted</item>
    </style>
</resources>
