<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:fitsSystemWindows="true">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="56dp" android:background="@color/surface" app:title="@string/vpn_title" app:navigationIcon="@drawable/ic_chevron_left" app:navigationContentDescription="@string/back" />
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingBottom="24dp">
    <ImageView android:id="@+id/shield" android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:src="@drawable/ic_shield_lock" android:importantForAccessibility="no" />
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="18dp" android:gravity="center" android:textColor="@color/muted" android:textSize="14sp" />
    <Button android:id="@+id/toggle" style="@style/Button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/connect_vpn" app:icon="@drawable/ic_shield_lock" />
    <TextView android:id="@+id/other" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/warn" android:textSize="13sp" android:text="@string/vpn_other" android:visibility="gone" />
    <com.google.android.material.card.MaterialCardView style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
                    <TextView style="@style/Hint" android:text="@string/vpn_device" />
                    <TextView android:id="@+id/device" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
                    <TextView style="@style/Hint" android:text="@string/vpn_address" />
                    <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
                    <TextView style="@style/Hint" android:text="@string/vpn_server" />
                    <TextView android:id="@+id/server" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
                    <TextView style="@style/Hint" android:text="@string/vpn_traffic" />
                    <TextView android:id="@+id/traffic" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="6dp">
                    <TextView style="@style/Hint" android:text="@string/vpn_last" />
                    <TextView android:id="@+id/last" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="15sp" />
                </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView style="@style/Hint" android:layout_marginBottom="8dp" android:text="@string/vpn_always" />
            <Button android:id="@+id/phone_settings" style="@style/Button.Tonal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vpn_settings" app:icon="@drawable/ic_settings" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
</ScrollView>
</LinearLayout>
