<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:background="@color/surface" android:gravity="center_vertical" android:paddingHorizontal="12dp">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="PiGuard" android:textStyle="bold" android:textSize="17sp" />
        <Button android:id="@+id/sos" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="64dp" android:text="@string/sos" android:textColor="#FFFFFF" android:backgroundTint="@color/danger" />
        <ImageButton android:id="@+id/settings" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@drawable/ic_settings" android:contentDescription="@string/settings_title" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" />
        <LinearLayout android:id="@+id/offline" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:gravity="center" android:orientation="vertical" android:padding="24dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/unreachable" android:textSize="18sp" />
            <Button android:id="@+id/vpn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/connect_vpn" />
            <Button android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
