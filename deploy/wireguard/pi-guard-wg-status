#!/bin/sh
# Writes WireGuard status for the pi-guard dashboard. Runs as root (wg needs
# CAP_NET_ADMIN); pi-guard itself only reads the result. Private and preshared
# keys are never written.
#
# Its folder belongs to root: pi-guard must not be able to leave a link where root writes.
set -eu
IFACE="${1:-wg0}"
DIR=/run/pi-guard-status
install -d -m 0750 -o root -g pi-guard "$DIR"
OUT="$DIR/wireguard.status"
TMP="$OUT.tmp"
{
    printf 'written\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # PiVPN keeps "name public-key date" per client
    if [ -f /etc/wireguard/configs/clients.txt ]; then
        awk '{ printf "name\t%s\t%s\n", $1, $2 }' /etc/wireguard/configs/clients.txt
    fi
    wg show "$IFACE" dump | awk -F'\t' 'BEGIN { OFS = "\t" }
        NR == 1 { print "(hidden)", $2, $3, $4; next }
        { $2 = "(hidden)"; print }'
} > "$TMP"
chgrp pi-guard "$TMP"
chmod 0640 "$TMP"
mv "$TMP" "$OUT"

# The tunnel to a rented relay server, if there is one (scripts/relay.sh).
RELAY=pgrelay
OUT="$DIR/relay.status"
TMP="$OUT.tmp"
if wg show "$RELAY" dump >/dev/null 2>&1; then
    {
        printf 'written\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        wg show "$RELAY" dump | awk -F'\t' 'BEGIN { OFS = "\t" }
            NR == 1 { print "(hidden)", $2, $3, $4; next }
            { $2 = "(hidden)"; print }'
    } > "$TMP"
    chgrp pi-guard "$TMP"
    chmod 0640 "$TMP"
    mv "$TMP" "$OUT"
else
    rm -f "$OUT"
fi
