# Optional: runs signal-cli as a JSON-RPC daemon for pi-guard.
# It runs as the pi-guard user so it can read the photos and videos it sends.
# Started without an account, so the dashboard can link a phone (see docs/signal.md).

[Unit]
Description=signal-cli daemon for pi-guard
After=network-online.target
Wants=network-online.target
Before=pi-guard.service

[Service]
Type=simple
User=pi-guard
Group=pi-guard
ExecStart=/usr/local/bin/signal-cli --config /var/lib/pi-guard/signal-cli daemon --tcp 127.0.0.1:7583 --receive-mode on-connection
Restart=always
RestartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/pi-guard/signal-cli

[Install]
WantedBy=multi-user.target
