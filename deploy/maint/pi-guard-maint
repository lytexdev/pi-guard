#!/usr/bin/env python3
"""Root jobs for pi-guard: the security scan, disk figures and two clean-ups.

pi-guard itself has no root rights. It leaves one word in a file; a systemd path unit starts
this program, which accepts only the words in JOBS. Reports go to a directory pi-guard cannot
write to, so a compromised pi-guard cannot trick root into overwriting anything.
"""

import grp
import json
import os
import re
import shutil
import subprocess
import time
from pathlib import Path

REQUEST = Path("/var/lib/pi-guard/maint/request")
REPORTS = Path("/var/lib/pi-guard-scan")
LIMIT = 20


def run(*command, timeout=900):
    try:
        done = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return done.stdout


def take_request():
    """Read and remove the request without following links."""
    try:
        fd = os.open(REQUEST, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        REQUEST.unlink(missing_ok=True)
        return ""
    with os.fdopen(fd) as file:
        word = file.read(32).strip()
    REQUEST.unlink(missing_ok=True)
    return word


def write(name, report):
    REPORTS.mkdir(mode=0o750, exist_ok=True)
    group = grp.getgrnam("pi-guard").gr_gid
    os.chown(REPORTS, 0, group)
    target = REPORTS / f"{name}.json"
    temporary = target.with_suffix(".tmp")
    temporary.write_text(json.dumps(report))
    os.chown(temporary, 0, group)
    temporary.chmod(0o640)
    temporary.replace(target)


def updates(report):
    run("apt-get", "update", "-qq", timeout=300)
    lines = [x for x in run("apt-get", "-s", "upgrade").splitlines() if x.startswith("Inst ")]
    report["updates"] = len(lines)
    report["security_updates"] = sum("-security" in x for x in lines)
    report["reboot_required"] = Path("/run/reboot-required").exists()
    report["unattended"] = "install ok installed" in run(
        "dpkg-query", "-W", "-f=${Status}", "unattended-upgrades"
    )


def firewall(report):
    status = run("ufw", "status") if shutil.which("ufw") else ""
    if "Status: active" in status:
        report["firewall"] = True
        report["firewall_detail"] = "ufw"
        return
    rules = run("nft", "list", "ruleset") if shutil.which("nft") else ""
    report["firewall"] = "policy drop" in rules
    report["firewall_detail"] = "nftables" if report["firewall"] else ""


def ssh(report):
    if not shutil.which("sshd"):
        return
    wanted = ("permitrootlogin", "passwordauthentication")
    settings = [x.split(None, 1) for x in run("sshd", "-T").splitlines()]
    report["ssh"] = {x[0]: x[1] for x in settings if len(x) == 2 and x[0] in wanted}


def packaged(path):
    return bool(run("dpkg", "-S", path).strip())


def files(report):
    # dpkg --verify prints "??5??????   /path", or with a "c" for configuration files.
    changed = []
    for line in run("nice", "dpkg", "--verify", timeout=1500).splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0][2] == "5":
            changed.append(parts[1])
    report["changed_files"] = changed[:LIMIT]
    found = run("find", "/", "-xdev", "-type", "f", "-perm", "-4000", timeout=600).splitlines()
    report["unknown_suid"] = [p for p in found if not packaged(p)][:LIMIT]


def suspicious(report):
    preload = Path("/etc/ld.so.preload")
    report["preload"] = [str(preload)] if preload.exists() and preload.read_text().strip() else []
    programs = []
    for folder in ("/tmp", "/var/tmp", "/dev/shm"):  # noqa: S108
        programs += run("find", folder, "-xdev", "-type", "f", "-perm", "/111").splitlines()
    report["tmp_programs"] = programs[:LIMIT]


def accounts(report):
    users = [x.split(":") for x in Path("/etc/passwd").read_text().splitlines()]
    report["extra_root_users"] = [u[0] for u in users if u[2] == "0" and u[0] != "root"]
    shadow = [x.split(":") for x in Path("/etc/shadow").read_text().splitlines()]
    report["empty_passwords"] = sum(1 for x in shadow if len(x) > 1 and x[1] == "")


def rootkits(report):
    if shutil.which("rkhunter"):
        output = run("rkhunter", "--check", "--skip-keypress", "--report-warnings-only", timeout=1500)
        report["rootkit_tool"] = "rkhunter"
    elif shutil.which("chkrootkit"):
        output = "\n".join(x for x in run("chkrootkit", "-q", timeout=1500).splitlines() if x.strip())
        report["rootkit_tool"] = "chkrootkit"
    else:
        report["rootkit_tool"] = None
        return
    report["rootkit_warnings"] = [x.strip()[:160] for x in output.splitlines()][:LIMIT]


def scan():
    report = {}
    for step in (updates, firewall, ssh, files, suspicious, accounts, rootkits):
        step(report)
    write("scan", report)


def disk():
    journal = re.search(r"([\d.]+)([KMGT])", run("journalctl", "--disk-usage"))
    factor = {"K": 1e3, "M": 1e6, "G": 1e9, "T": 1e12}
    cache = run("du", "-sb", "/var/cache/apt").split()
    folders = []
    for line in run("du", "-xb", "--max-depth=2", "/", timeout=600).splitlines():
        size, path = line.split("\t", 1)
        folders.append({"path": path, "bytes": int(size)})
    folders.sort(key=lambda f: f["bytes"], reverse=True)
    write("disk", {
        "journal": int(float(journal[1]) * factor[journal[2]]) if journal else 0,
        "apt": int(cache[0]) if cache else 0,
        "folders": [f for f in folders if f["path"] != "/"][:12],
    })


def clean_journal():
    run("journalctl", "--vacuum-time=14d")
    disk()


def clean_apt():
    run("apt-get", "clean")
    disk()


# --- fixes ------------------------------------------------------------------------------
# A fixed list of corrections the security check may offer, each with a way back. pi-guard and
# its assistant can only name one of these words; what runs is written here. Backups stay in
# a folder only root can read.

BACKUPS = Path("/var/lib/pi-guard-fixes")
SSH_DROPIN = Path("/etc/ssh/sshd_config.d/05-pi-guard.conf")  # first file wins in sshd
AUTO_UPGRADES = Path("/etc/apt/apt.conf.d/20auto-upgrades")
RKHUNTER_DB = Path("/var/lib/rkhunter/db/rkhunter.dat")
APT_ENV = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}


class FixError(Exception):
    pass


def journal():
    try:
        return json.loads((BACKUPS / "journal.json").read_text())
    except (OSError, ValueError):
        return {}


def save_journal(data):
    BACKUPS.mkdir(mode=0o700, exist_ok=True)
    os.chown(BACKUPS, 0, 0)
    BACKUPS.chmod(0o700)
    target = BACKUPS / "journal.json"
    temporary = target.with_suffix(".tmp")
    temporary.write_text(json.dumps(data))
    temporary.chmod(0o600)
    temporary.replace(target)
    # pi-guard may see which fixes are in place, not the backups.
    write("fixes", {name: {"applied": entry["applied"]} for name, entry in data.items()})


def keep(path):
    """The file as it was: its text, or None if there was none."""
    return path.read_text() if path.is_file() else None


def put_back(path, text):
    if text is None:
        path.unlink(missing_ok=True)
    else:
        path.write_text(text)


def ssh_settings(changes):
    """Write settings into our sshd drop-in, check them, reload. Returns the old drop-in."""
    before = keep(SSH_DROPIN)
    lines = {}
    for line in (before or "").splitlines():
        if line.strip() and not line.startswith("#"):
            key, _, value = line.partition(" ")
            lines[key] = value
    lines.update(changes)
    SSH_DROPIN.parent.mkdir(exist_ok=True)
    SSH_DROPIN.write_text("# Written by pi-guard's security check; undo it in the dashboard.\n"
                          + "".join(f"{k} {v}\n" for k, v in lines.items()))
    if subprocess.run(["sshd", "-t"], capture_output=True, check=False).returncode != 0:
        put_back(SSH_DROPIN, before)
        raise FixError("sshd refused the change; nothing was changed")
    reload_ssh()
    return before


def reload_ssh():
    for unit in ("ssh", "sshd"):
        done = subprocess.run(["systemctl", "reload", unit], capture_output=True, check=False)
        if done.returncode == 0:
            return


def has_ssh_key():
    homes = [Path("/root"), *(Path("/home").iterdir() if Path("/home").is_dir() else [])]
    for home in homes:
        keys = home / ".ssh" / "authorized_keys"
        try:
            lines = keys.read_text().splitlines()
        except OSError:
            continue
        if any(line.strip() and not line.startswith("#") for line in lines):
            return True
    return False


def apply_ssh_root():
    return {"dropin": ssh_settings({"PermitRootLogin": "no"})}


def apply_ssh_passwords():
    if not has_ssh_key():
        raise FixError("no SSH key is set up: switching off passwords would lock you out")
    return {"dropin": ssh_settings({"PasswordAuthentication": "no",
                                    "KbdInteractiveAuthentication": "no"})}


def undo_ssh(backup):
    put_back(SSH_DROPIN, backup.get("dropin"))
    reload_ssh()


def apply_auto_updates():
    status = run("dpkg-query", "-W", "-f=${Status}", "unattended-upgrades")
    before = "install ok installed" in status
    backup = {"file": keep(AUTO_UPGRADES), "installed": before}
    if not before:
        done = subprocess.run(["apt-get", "install", "-y", "-qq", "unattended-upgrades"],
                              capture_output=True, env=APT_ENV, timeout=900, check=False)
        if done.returncode != 0:
            raise FixError("unattended-upgrades could not be installed")
    AUTO_UPGRADES.write_text('APT::Periodic::Update-Package-Lists "1";\n'
                             'APT::Periodic::Unattended-Upgrade "1";\n')
    return backup


def undo_auto_updates(backup):
    put_back(AUTO_UPGRADES, backup.get("file"))
    if not backup.get("installed"):
        subprocess.run(["apt-get", "remove", "-y", "-qq", "unattended-upgrades"],
                       capture_output=True, env=APT_ENV, timeout=900, check=False)


def apply_rkhunter():
    if not shutil.which("rkhunter"):
        raise FixError("rkhunter is not installed")
    backup = {"db": RKHUNTER_DB.read_bytes().hex() if RKHUNTER_DB.is_file() else None}
    run("rkhunter", "--propupd", "--quiet", timeout=900)
    return backup


def undo_rkhunter(backup):
    if backup.get("db") is not None:
        RKHUNTER_DB.write_bytes(bytes.fromhex(backup["db"]))


def apply_firewall():
    if not shutil.which("ufw"):
        raise FixError("ufw is not installed: sudo apt install ufw")
    if "Status: active" in run("ufw", "status"):  # nothing to do or undo
        raise FixError("the firewall is already on")
    # Everything that answers on the network today stays reachable, SSH above all: this only
    # closes what is not open yet.
    allowed = {"22/tcp"}
    for line in run("ss", "-H", "-ltun").splitlines():
        fields = line.split()
        if len(fields) >= 5:
            host, _, port = fields[4].rpartition(":")
            if port.isdigit() and not host.startswith(("127.", "[::1]", "[::ffff:127.")):
                allowed.add(f"{port}/{'tcp' if fields[0] == 'tcp' else 'udp'}")
    for rule in sorted(allowed):
        run("ufw", "allow", rule)
    if "active" not in run("ufw", "--force", "enable"):
        raise FixError("ufw could not be switched on")
    return {"rules": sorted(allowed)}


def undo_firewall(backup):
    run("ufw", "--force", "disable")


FIXES = {
    "ssh-root": (apply_ssh_root, undo_ssh),
    "ssh-passwords": (apply_ssh_passwords, undo_ssh),
    "auto-updates": (apply_auto_updates, undo_auto_updates),
    "rkhunter": (apply_rkhunter, undo_rkhunter),
    "firewall": (apply_firewall, undo_firewall),
}


def fix(name, undo):
    data = journal()
    result = {"id": name, "undo": undo, "ok": False, "time": int(time.time())}
    try:
        apply, revert = FIXES[name]
        if undo:
            if name not in data:
                raise FixError("this fix is not in place")
            revert(data.pop(name)["backup"])
        else:
            if name in data:
                raise FixError("this fix is already in place")
            data[name] = {"applied": int(time.time()), "backup": apply()}
        save_journal(data)
        result["ok"] = True
    except FixError as exc:
        result["message"] = str(exc)
    except (OSError, subprocess.SubprocessError, ValueError) as exc:
        result["message"] = type(exc).__name__
    write("fix", result)


JOBS = {"scan": scan, "disk": disk, "clean-journal": clean_journal, "clean-apt": clean_apt}
for _name in FIXES:
    JOBS[f"fix-{_name}"] = lambda n=_name: fix(n, undo=False)
    JOBS[f"undo-{_name}"] = lambda n=_name: fix(n, undo=True)

if __name__ == "__main__":
    job = JOBS.get(take_request())
    if job:
        job()
