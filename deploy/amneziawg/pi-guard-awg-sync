#!/bin/bash
# Keeps the obfuscated VPN (awg0, AmneziaWG) in step with the normal one (wg0).
#
# wg0 stays the one place where VPN devices are managed (pi-guard-wg-apply loads them, the
# post-quantum service rotates their keys). Every second this copies each device's key, preshared
# key and address to awg0, removes devices that are gone, and routes a device's address through
# the interface it greeted last: a phone on a hotel network reaches home over awg0 with the same
# 10.8.0.N it has over wg0, so Pi-hole, presence and the dashboard see one device.
#
# Runs as root. Nothing here comes from pi-guard directly; values from wg are still checked
# before they reach awg or ip, and preshared keys go through a pipe, never the argument list.
set -uo pipefail
WG="${PI_GUARD_WG_IFACE:-wg0}"
AWG="${PI_GUARD_AWG_IFACE:-awg0}"
EVERY="${PI_GUARD_AWG_EVERY:-1}"
ONCE="${PI_GUARD_AWG_ONCE:-}"
KEY_RE='^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$'
IP_RE='^10\.8\.0\.([2-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-4])/32$'
NUM_RE='^[0-9]{1,12}$'

# "key<TAB>value" lines of `wg show IFACE WHAT` into the named array.
load() {
    local tool="$1" iface="$2" what="$3" pub value
    local -n into="$4"
    while IFS=$'\t' read -r pub value; do
        [[ "$pub" =~ $KEY_RE ]] && into[$pub]="$value"
    done < <("$tool" show "$iface" "$what" 2>/dev/null)
}

sync_once() {
    local -A WPSK=() WIP=() WHS=() APSK=() AIP=() AHS=()
    "$tool_awg" show "$AWG" >/dev/null 2>&1 || return 0
    load "$tool_wg" "$WG" preshared-keys WPSK
    load "$tool_wg" "$WG" allowed-ips WIP
    load "$tool_wg" "$WG" latest-handshakes WHS
    load "$tool_awg" "$AWG" preshared-keys APSK
    load "$tool_awg" "$AWG" allowed-ips AIP
    load "$tool_awg" "$AWG" latest-handshakes AHS
    local pub psk ip
    for pub in "${!WIP[@]}"; do
        psk="${WPSK[$pub]:-}" ip="${WIP[$pub]}"
        [[ "$ip" =~ $IP_RE && "$psk" =~ $KEY_RE ]] || continue
        if [[ "${APSK[$pub]:-}" != "$psk" || "${AIP[$pub]:-}" != "$ip" ]]; then
            "$tool_awg" set "$AWG" peer "$pub" preshared-key <(printf '%s\n' "$psk") allowed-ips "$ip"
        fi
        # The newer greeting decides; a device never seen on awg0 keeps the normal route.
        local on_awg=0 seen_awg="${AHS[$pub]:-0}" seen_wg="${WHS[$pub]:-0}"
        [[ "$seen_awg" =~ $NUM_RE && "$seen_wg" =~ $NUM_RE ]] || continue
        (( seen_awg > 0 && seen_awg > seen_wg )) && on_awg=1
        if (( on_awg )); then
            [[ -n "$("$tool_ip" route show "${ip%/32}" dev "$AWG" 2>/dev/null)" ]] || "$tool_ip" route replace "$ip" dev "$AWG"
        else
            [[ -z "$("$tool_ip" route show "${ip%/32}" dev "$AWG" 2>/dev/null)" ]] || "$tool_ip" route del "$ip" dev "$AWG"
        fi
    done
    for pub in "${!AIP[@]}"; do
        [[ -n "${WIP[$pub]:-}" ]] && continue
        ip="${AIP[$pub]}"
        "$tool_awg" set "$AWG" peer "$pub" remove
        [[ "$ip" =~ $IP_RE ]] && "$tool_ip" route del "$ip" dev "$AWG" 2>/dev/null
    done
    return 0
}

tool_awg="${PI_GUARD_AWG_TOOL:-awg}"
tool_wg="${PI_GUARD_WG_TOOL:-wg}"
tool_ip="${PI_GUARD_IP_TOOL:-ip}"
while true; do
    sync_once
    [[ -n "$ONCE" ]] && exit 0
    sleep "$EVERY"
done
