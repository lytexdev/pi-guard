#!/bin/bash
# Loads the optional upstream WireGuard exit (pgexit) from pi-guard's privacy folder.
#
# pi-guard runs without root and writes privacy/exit.peer. Nothing in that file is
# trusted: every field is checked before wg or ip see it. When the file is missing
# or empty, the exit interface is brought down.
set -euo pipefail
IFACE="${PI_GUARD_EXIT_IFACE:-pgexit}"
SRC="${PI_GUARD_PRIVACY_DIR:-/var/lib/pi-guard/privacy}/exit.peer"
CONF_DIR="${PI_GUARD_EXIT_DIR:-/etc/wireguard}"
CONF="$CONF_DIR/$IFACE.conf"
STATUS_DIR="${PI_GUARD_STATUS_DIR:-/run/pi-guard-status}"
KEY_RE='^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$'
# "]" first: inside brackets a backslash is no escape, and "\]" ended the class early, so every
# endpoint was refused.
ENDPOINT_RE='^[][A-Za-z0-9.:_%-]{3,253}$'
ADDR_RE='^[0-9a-fA-F:.]+/[0-9]{1,3}$'
MTU_RE='^[0-9]{3,4}$'
TABLE_ID=51821
HOME_IFACE="${PI_GUARD_HOME_IFACE:-wg0}"
HIDDEN_IFACE="${PI_GUARD_HIDDEN_IFACE:-awg0}" # AmneziaWG, the same devices disguised
# Traffic from the home VPN: first the main table without its default route (LAN, the VPN
# itself), then the exit. The kill switch in nft.plan drops what would still leave another way.
RULE_MAIN=10900
RULE_EXIT=10901

umask 077
mkdir -p "$STATUS_DIR"
write_status() {
    printf '%s\n' "$@" > "$STATUS_DIR/privacy.exit"
}

down() {
    if [[ -n "${PI_GUARD_EXIT_DIR:-}" ]]; then
        # test mode: only write files
        rm -f "$CONF"
        write_status "up=0" "reason=cleared"
        return 0
    fi
    if ip link show "$IFACE" >/dev/null 2>&1; then
        wg-quick down "$IFACE" >/dev/null 2>&1 || ip link delete "$IFACE" 2>/dev/null || true
    fi
    rm -f "$CONF"
    write_status "up=0" "reason=cleared"
    echo "pi-guard-exit-apply: $IFACE down"
}

if [[ ! -f "$SRC" || -L "$SRC" || ! -s "$SRC" ]]; then
    down
    exit 0
fi

# One line: pubkey TAB psk TAB endpoint TAB allowed_ips TAB address TAB private_key TAB mtu
IFS=$'\t' read -r pub psk endpoint allowed address private mtu extra < <(head -c 4096 "$SRC")
if [[ -n "${extra:-}" || ! "$pub" =~ $KEY_RE || ! "$psk" =~ $KEY_RE || ! "$private" =~ $KEY_RE \
    || ! "$endpoint" =~ $ENDPOINT_RE || ! "$address" =~ $ADDR_RE || ! "$mtu" =~ $MTU_RE \
    || "$allowed" == *";"* || "$allowed" == *" "* || "$allowed" == *$'\n'* ]]; then
    echo "pi-guard-exit-apply: invalid exit.peer; leaving previous state" >&2
    write_status "up=0" "reason=invalid"
    exit 1
fi
if [[ "$mtu" -lt 576 || "$mtu" -gt 1500 ]]; then
    echo "pi-guard-exit-apply: bad mtu" >&2
    write_status "up=0" "reason=mtu"
    exit 1
fi

mkdir -p "$CONF_DIR"
TMP="$(mktemp "$CONF_DIR/.$IFACE.XXXXXX")"
trap 'rm -f "$TMP"' EXIT
{
    printf '[Interface]\nPrivateKey = %s\nAddress = %s\nMTU = %s\nTable = %s\n' \
        "$private" "$address" "$mtu" "$TABLE_ID"
    printf 'PostUp = ip rule add from %s table %s; ip rule add to %s table %s\n' \
        "${address%/*}" "$TABLE_ID" "${address%/*}" "$TABLE_ID"
    for home in "$HOME_IFACE" "$HIDDEN_IFACE"; do
        printf 'PostUp = ip rule add iif %s lookup main suppress_prefixlength 0 priority %s; ip rule add iif %s table %s priority %s\n' \
            "$home" "$RULE_MAIN" "$home" "$TABLE_ID" "$RULE_EXIT"
    done
    printf 'PostDown = ip rule del from %s table %s; ip rule del to %s table %s\n' \
        "${address%/*}" "$TABLE_ID" "${address%/*}" "$TABLE_ID"
    printf 'PostDown = ip rule del priority %s; ip rule del priority %s; ip rule del priority %s; ip rule del priority %s\n' \
        "$RULE_MAIN" "$RULE_EXIT" "$RULE_MAIN" "$RULE_EXIT"
    printf '\n[Peer]\nPublicKey = %s\n' "$pub"
    if [[ "$psk" != AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA= ]]; then
        printf 'PresharedKey = %s\n' "$psk"
    fi
    printf 'Endpoint = %s\nAllowedIPs = %s\nPersistentKeepalive = 25\n' "$endpoint" "$allowed"
} > "$TMP"
chmod 0600 "$TMP"
mv "$TMP" "$CONF"
trap - EXIT

if [[ -n "${PI_GUARD_EXIT_DIR:-}" ]]; then
    write_status "up=1" "endpoint=$endpoint" "handshake_age=" "rx=0" "tx=0"
    echo "pi-guard-exit-apply: wrote $CONF (test mode)"
    exit 0
fi

if ip link show "$IFACE" >/dev/null 2>&1; then
    wg syncconf "$IFACE" <(wg-quick strip "$CONF")
else
    wg-quick up "$CONF"
fi

# Policy routing: send traffic from the home VPN subnet out via the exit table when marked
# by the privacy nft/nat rules. Basic default route in the exit table:
ip route replace default dev "$IFACE" table "$TABLE_ID" 2>/dev/null || true

HANDSHAKE="$(wg show "$IFACE" latest-handshakes 2>/dev/null | awk 'NR==1 {print $2}')"
NOW="$(date +%s)"
AGE=""
if [[ -n "${HANDSHAKE:-}" && "$HANDSHAKE" =~ ^[0-9]+$ && "$HANDSHAKE" -gt 0 ]]; then
    AGE=$((NOW - HANDSHAKE))
fi
RX="$(wg show "$IFACE" transfer 2>/dev/null | awk 'NR==1 {print $2}')"
TX="$(wg show "$IFACE" transfer 2>/dev/null | awk 'NR==1 {print $3}')"
write_status "up=1" "endpoint=$endpoint" "handshake_age=${AGE:-}" "rx=${RX:-0}" "tx=${TX:-0}"
echo "pi-guard-exit-apply: $IFACE up → $endpoint"
