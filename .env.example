# pi-guard settings. Copy to .env (development) or /etc/pi-guard/pi-guard.env (installed).
# Keep comments on their own lines: Docker and systemd do not strip trailing comments.
# Cameras, zones, trusted devices and alert rules go in config.yaml.

# en or de; each user can switch their own language in chat
PI_GUARD_LANGUAGE=de
PI_GUARD_TIMEZONE=Europe/Berlin
PI_GUARD_LOG_LEVEL=INFO

# Paths (defaults shown)
#PI_GUARD_DATA_DIR=/var/lib/pi-guard
#PI_GUARD_RECORDINGS_DIR=/var/lib/pi-guard/recordings
#PI_GUARD_CONFIG_FILE=/etc/pi-guard/config.yaml

# Telegram: create a bot with @BotFather. The bot ID is derived from the token.
# Admin and viewer IDs are *user* IDs (ask @userinfobot), not the bot ID.
PI_GUARD_TELEGRAM_ENABLED=true
PI_GUARD_TELEGRAM_BOT_TOKEN=
PI_GUARD_TELEGRAM_ADMIN_USER_IDS=
PI_GUARD_TELEGRAM_VIEWER_USER_IDS=
# Group chats that may use the bot and receive alerts (negative numbers).
PI_GUARD_TELEGRAM_ALLOWED_CHAT_IDS=
PI_GUARD_TELEGRAM_GROUP_PLAIN_TEXT=false

# Signal (unofficial, needs a running signal-cli daemon; see docs/signal.md)
PI_GUARD_SIGNAL_ENABLED=false
PI_GUARD_SIGNAL_PHONE_NUMBER=
PI_GUARD_SIGNAL_ADMIN_NUMBERS=
PI_GUARD_SIGNAL_ALLOWED_NUMBERS=
#PI_GUARD_SIGNAL_CLI_ADDRESS=127.0.0.1:7583

# Emergency / backup contacts: written to when alerts stay unconfirmed
# (nobody pressed "Everything is fine" or "I am at home"). They must have
# started the Telegram bot once. Telegram user IDs and/or Signal numbers.
PI_GUARD_EMERGENCY_TELEGRAM_USER_IDS=
PI_GUARD_EMERGENCY_SIGNAL_NUMBERS=
PI_GUARD_EMERGENCY_AFTER_ALERTS=3
PI_GUARD_EMERGENCY_AFTER_MINUTES=30

PI_GUARD_RECORDING_ENABLED=true
# false: keep only footage around motion events
PI_GUARD_RECORDING_CONTINUOUS=true
PI_GUARD_RECORDING_RETENTION_DAYS=7
PI_GUARD_RECORDING_MAX_STORAGE_PERCENT=85
#PI_GUARD_RECORDING_MIN_FREE_MB=1024
#PI_GUARD_RECORDING_SEGMENT_SECONDS=300
#PI_GUARD_RECORDING_BUFFER_MINUTES=15

PI_GUARD_MOTION_ENABLED=true
PI_GUARD_MOTION_SENSITIVITY=50

PI_GUARD_DEFAULT_MODE=HOME
PI_GUARD_PRESENCE_ENABLED=false
# May presence detection switch to HOME by itself when a trusted device appears?
# false: it still arms (AWAY) automatically, but switching back to HOME needs a
# person to press "I am at home"; a phone in the Wi-Fi is not proof of who is there.
PI_GUARD_PRESENCE_AUTO_HOME=true
# May presence detection switch to AWAY by itself when all trusted devices are gone?
PI_GUARD_PRESENCE_AUTO_AWAY=true
#PI_GUARD_FRITZBOX_PASSWORD=

# Biometric processing: read docs/privacy.md before enabling.
PI_GUARD_PERSON_DETECTION_ENABLED=false
PI_GUARD_FACE_RECOGNITION_ENABLED=false

# Audio: read docs/privacy.md before enabling the microphone.
PI_GUARD_AUDIO_RECORDING_ENABLED=false
PI_GUARD_AUDIO_PLAYBACK_ENABLED=false
PI_GUARD_AUDIO_MAX_VOLUME=80

# Pi-hole v6 (optional): statistics, pausing ad blocking, LAN devices and
# presence detection by DNS activity (presence.sources: [neighbours, pihole]).
# Use an app password (Pi-hole: Settings > Web interface / API).
PI_GUARD_PIHOLE_ENABLED=false
PI_GUARD_PIHOLE_URL=http://127.0.0.1
PI_GUARD_PIHOLE_PASSWORD=
# WireGuard/PiVPN status in the dashboard (needs the pi-guard-wg-status timer).
PI_GUARD_WIREGUARD_ENABLED=false
PI_GUARD_WIREGUARD_INTERFACE=wg0

PI_GUARD_MQTT_ENABLED=false
PI_GUARD_MQTT_HOST=
PI_GUARD_MQTT_PORT=1883
#PI_GUARD_MQTT_USERNAME=
#PI_GUARD_MQTT_PASSWORD=
#PI_GUARD_MQTT_TLS=false
#PI_GUARD_MQTT_TOPIC_PREFIX=pi-guard
#PI_GUARD_MQTT_HOME_ASSISTANT_DISCOVERY=false
#PI_GUARD_MQTT_COMMANDS_ENABLED=false

# Web dashboard (optional). See docs/dashboard.md.
PI_GUARD_DASHBOARD_ENABLED=false
PI_GUARD_DASHBOARD_PORT=8443
# Login: password, keyfile, or both (comma-separated). "none" only on 127.0.0.1
# or with PI_GUARD_DASHBOARD_ALLOW_UNAUTHENTICATED=true.
PI_GUARD_DASHBOARD_AUTH=password
PI_GUARD_DASHBOARD_USERNAME=admin
# Create with: pi-guard dashboard password
PI_GUARD_DASHBOARD_PASSWORD_HASH=
# Optional two-factor login. Create with: pi-guard dashboard totp
PI_GUARD_DASHBOARD_TOTP_SECRET=
# HTTPS with a local certificate authority (needed for the app, push and the microphone).
PI_GUARD_DASHBOARD_TLS=true
PI_GUARD_DASHBOARD_HONEYPOT=true
PI_GUARD_DASHBOARD_BAN_MINUTES=60
PI_GUARD_DASHBOARD_RATE_LIMIT_PER_MINUTE=240
# Live view frames per second (0 = off) and picture width.
PI_GUARD_DASHBOARD_LIVE_FPS=8
PI_GUARD_DASHBOARD_LIVE_WIDTH=960
# Push notifications to the installed dashboard app. Text only, end-to-end
# encrypted, delivered through the browser vendor's push service.
PI_GUARD_WEBPUSH_ENABLED=false
PI_GUARD_WEBPUSH_CONTACT=mailto:you@example.org
